# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Per BR § 2.8 (Strict data classification), all secrets are env-vars only —
# never inline in code, never in logs, never in error responses.

# ── api ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
GIT_SHA=dev

# Postgres
DATABASE_URL=postgresql://app:app@localhost:5432/ecommmer_dev?schema=app

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate keys with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem; openssl rsa -in private.pem -pubout -out public.pem)
# Stored as base64 of the PEM contents to keep .env single-line-friendly.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# LLM provider — finalized in UoW-11 (Stage 11 cost projection required)
LLM_PROVIDER=
LLM_PROVIDER_API_KEY=
LLM_MODEL=

# OTel — wired in UoW-04
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ecommmer-api

# Sentry — wired in UoW-04
SENTRY_DSN=

# ── web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
