# ============================================================================
# Local development env. Copy this file to api/.env and fill in the blanks.
# ============================================================================

# --- App ---
PORT=3001
NODE_ENV=development
GIT_SHA=dev

# --- Database (Postgres + pgvector via docker-compose in /infra) ---
DATABASE_URL=postgresql://app:app@localhost:5432/ecommmer_dev
AUDIT_DATABASE_URL=postgresql://app:app@localhost:5432/ecommmer_dev

# --- Redis (sessions, rate-limit) ---
REDIS_URL=redis://localhost:6379

# --- JWT auth (RS256). Generate dev keys with the helper below. ---
# openssl genrsa -out /tmp/jwt-private.pem 2048
# openssl rsa -in /tmp/jwt-private.pem -pubout -out /tmp/jwt-public.pem
# JWT_PRIVATE_KEY_B64=$(base64 -w0 /tmp/jwt-private.pem)
# JWT_PUBLIC_KEY_B64=$(base64 -w0 /tmp/jwt-public.pem)
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- LLM provider (Anthropic by default; openai also supported) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
# Get a key from https://console.anthropic.com/settings/keys
# Set BOTH variables to the same value (different parts of the codebase read each).
LLM_API_KEY=
LLM_PROVIDER_API_KEY=
LLM_BUDGET_WEEKLY_USD=100

# --- Observability (all optional for local dev) ---
SENTRY_DSN=
OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=api
OTEL_SERVICE_VERSION=dev
