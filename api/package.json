    "fast-check": "3.22.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.2",
    "unplugin-swc": "1.5.9",
    "vitest": "2.1.9"
