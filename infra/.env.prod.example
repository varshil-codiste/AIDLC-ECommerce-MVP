# Production environment variables — copy to /opt/ecommmer/.env.prod on the VPS.
# NEVER commit .env.prod to git. This example file is safe to commit.

# ── Docker Compose ───────────────────────────────────────────────────────────
GHCR_REPO=<github-org>/<repo-name>
IMAGE_TAG=latest

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=ecommmer_prod

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<strong-random-password>

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: bash scripts/generate-jwt-keys.sh
JWT_PRIVATE_KEY_B64=<base64-encoded-pkcs8-pem>
JWT_PUBLIC_KEY_B64=<base64-encoded-spki-pem>

# ── CORS ─────────────────────────────────────────────────────────────────────
WEB_ORIGIN=https://<your-domain>

# ── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://<your-domain>/api/v1

# ── Caddy ────────────────────────────────────────────────────────────────────
DOMAIN=<your-domain>
