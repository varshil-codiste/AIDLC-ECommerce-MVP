{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["orderId", "status", "totalCents", "currency", "placedAt", "items"],
  "properties": {
    "orderId": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled", "refunded"] },
    "totalCents": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string" },
    "placedAt": { "type": "string" },
    "trackingNumber": { "type": "string" },
    "trackingCarrier": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "quantity", "priceAtPurchaseCents"],
        "properties": {
          "title": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "priceAtPurchaseCents": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "cancelAction": {
      "type": "object",
      "required": ["intent"],
      "properties": { "intent": { "type": "string" } }
    },
    "refundAction": {
      "type": "object",
      "required": ["intent"],
      "properties": { "intent": { "type": "string" } }
    }
  },
  "additionalProperties": false
}
