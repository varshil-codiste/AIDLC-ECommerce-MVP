{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["products", "differingAttributes"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "priceCents", "currency", "attributes"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "priceCents": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string" },
          "imageUrl": { "type": "string" },
          "categoryName": { "type": "string" },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "differingAttributes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
