{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["productId", "title", "priceCents", "currency"],
        "properties": {
          "productId": { "type": "string" },
          "title": { "type": "string" },
          "priceCents": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string" },
          "imageUrl": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "query": { "type": "string" }
  },
  "additionalProperties": false
}
